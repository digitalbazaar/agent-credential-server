# Copy to .env (which is gitignored) and fill in as needed.
# The demo-agent loads this file automatically at startup.

# Anthropic — required only for `--provider=anthropic` (the default).
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Optional overrides:
# AGENT_PROVIDER=anthropic        # default provider
#                                 # (anthropic | ollama | openai-compatible)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OLLAMA_MODEL=qwen2.5            # ollama is local and needs no API key

# OpenAI-compatible provider — any OpenAI-style endpoint (DeepSeek, Kimi/
# Moonshot, OpenAI, a HuggingFace TGI server, …). Used with
# `--provider=openai-compatible`. Example values are for DeepSeek.
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
# OPENAI_COMPATIBLE_MODEL=deepseek-chat
# OPENAI_COMPATIBLE_API_KEY=
